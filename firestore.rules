rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountActive() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.is_active != false
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == request.auth.token.role;
    }

    function hasRole(role) {
      return accountActive() && request.auth.token.role == role;
    }

    function isPatient() {
      return hasRole('patient');
    }

    function isReceptionist() {
      return hasRole('receptionist');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function doctorOwnsDepartment(departmentId) {
      return isDoctor()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid))
          .data.is_active != false
        && (
          get(/databases/$(database)/documents/staff/$(request.auth.uid))
            .data.department_id == departmentId
          || get(/databases/$(database)/documents/staff/$(request.auth.uid))
            .data.departmentId == departmentId
        );
    }

    function isScheduler() {
      return hasRole('scheduling_officer');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isAppointmentStaff() {
      return isReceptionist() || isAdmin();
    }

    function isOwn(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwn(uid) || isAdmin();
      allow list: if isAdmin()
        || (isScheduler()
          && resource.data.role == 'doctor');
      allow create: if isOwn(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'patient'
        && request.resource.data.is_active == true
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'full_name', 'phone_number', 'role', 'photo_url',
          'is_active', 'created_at', 'updated_at'
        ]);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['full_name', 'phone_number', 'photo_url', 'updated_at']))
        || (isOwn(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'full_name', 'phone_number', 'photo_url', 'updated_at', 'fcmToken'
            ]));
      allow delete: if isAdmin();
    }

    match /patients/{uid} {
      allow read: if isOwn(uid) || isReceptionist() || isAdmin();
      allow create: if isOwn(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'patient';
      allow update: if isAdmin()
        || (isOwn(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'firstName', 'lastName', 'full_name', 'phoneNumber',
              'phone_number', 'dateOfBirth', 'gender', 'bloodGroup',
              'emergencyContactPhone', 'address', 'photoUrl', 'updatedAt'
            ]))
        || (isReceptionist()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'firstName', 'lastName', 'full_name', 'phoneNumber',
              'phone_number', 'dateOfBirth', 'gender', 'bloodGroup',
              'emergencyContactPhone', 'address', 'photoUrl', 'updatedAt'
            ]));
      allow delete: if isAdmin();
    }

    match /staff/{uid} {
      allow read: if isOwn(uid) || isScheduler() || isAdmin();
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwn(uid) || isAdmin();
      allow write: if false;
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /appointment_slots/{slotId} {
      allow read: if signedIn();
      allow create: if (isScheduler() || isAdmin()
          || (request.resource.data.doctorId == request.auth.uid
            && doctorOwnsDepartment(request.resource.data.departmentId)))
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.bookedCount == 0
        && request.resource.data.date is timestamp
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string;
      allow update: if (isScheduler() || isAdmin())
        && request.resource.data.bookedCount == resource.data.bookedCount
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= resource.data.bookedCount;
      allow update: if doctorOwnsDepartment(resource.data.departmentId)
        && resource.data.doctorId == request.auth.uid
        && request.resource.data.doctorId == request.auth.uid
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.bookedCount == resource.data.bookedCount
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= resource.data.bookedCount
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'date', 'startTime', 'endTime', 'capacity', 'isActive', 'updatedAt'
          ]);
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if (isPatient() && resource.data.patientId == request.auth.uid)
        || (isDoctor() && resource.data.doctorId == request.auth.uid)
        || isAppointmentStaff();
      allow create, delete: if false;
      allow update: if (
        isPatient()
        && resource.data.patientId == request.auth.uid
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status in [
          'cancel_requested', 'reschedule_requested'
        ]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'cancellationReason', 'requestedSlotId',
            'requestedTime', 'updatedAt'
          ])
      ) || (
        isAppointmentStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancellationReason', 'updatedAt', 'checkedInAt'])
        && request.resource.data.status in [
          'pending', 'confirmed', 'cancelled', 'checked_in', 'completed',
          'no_show'
        ]
      ) || (
        isDoctor()
        && resource.data.doctorId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
      ) || (
        isDoctor()
        && resource.data.doctorId == request.auth.uid
        && resource.data.status in ['confirmed', 'checked_in']
        && request.resource.data.status in ['completed', 'no_show']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
      );
    }

    match /booking_requests/{requestId} {
      allow create: if isPatient()
        && request.resource.data.patientId == request.auth.uid;
      allow read: if (isPatient()
          && resource.data.patientId == request.auth.uid)
        || isAdmin();
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']);
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
