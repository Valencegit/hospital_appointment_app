# ─────────────────────────────────────────────────────────────────────────────
# .env.example  — copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# Obtain all values from your Firebase Console:
#   https://console.firebase.google.com/project/YOUR_PROJECT_ID/settings/general
# ─────────────────────────────────────────────────────────────────────────────

# Firebase — Android
FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_ANDROID_APP_ID=1:your_project_number:android:your_app_hash
FIREBASE_MESSAGING_SENDER_ID=your_project_number
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
FIREBASE_ANDROID_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com

# Firebase Cloud Messaging — Web push VAPID public key
# Found in Firebase Console → Project Settings → Cloud Messaging → Web configuration
FIREBASE_VAPID_KEY=your_web_push_vapid_public_key_here
